+// DIAGNOSTIC ONLY: this code is applied to a disposable source archive.
+type DiagnosticConnection = Option<(std::net::SocketAddr, std::net::SocketAddr)>;
+
+fn diagnostic_event(event: &str, connection: DiagnosticConnection, bytes: usize, result: &str) {
+    use std::io::Write as _;
+    let time_ns = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_nanos();
+    let (local, peer) = connection
+        .map(|(local, peer)| (local.to_string(), peer.to_string()))
+        .unwrap_or_else(|| ("unavailable".to_owned(), "unavailable".to_owned()));
+    let record = format!(
+        "NATIVE_TLS_TRACE {{\"time_ns\":{time_ns},\"event\":\"{event}\",\"local\":\"{local}\",\"peer\":\"{peer}\",\"bytes\":{bytes},\"result\":\"{result}\",\"thread\":\"{:?}\"}}\n",
+        std::thread::current().id()
+    );
+    let _ = std::io::stderr().lock().write_all(record.as_bytes());
+}
+
+struct DiagnosticIo<IO> {
+    inner: IO,
+    connection: DiagnosticConnection,
+    events: usize,
+}
+
+impl<IO> DiagnosticIo<IO> {
+    fn observe(&mut self, event: &str, bytes: usize, result: &str) {
+        // Bound diagnostic overhead even if a transport repeatedly returns Pending.
+        if self.events < 128 {
+            diagnostic_event(event, self.connection, bytes, result);
+        } else if self.events == 128 {
+            diagnostic_event("trace_truncated", self.connection, 0, "incomplete");
+        }
+        self.events = self.events.saturating_add(1);
+    }
+}
+
+impl<IO: AsyncRead + Unpin> AsyncRead for DiagnosticIo<IO> {
+    fn poll_read(
+        self: Pin<&mut Self>,
+        context: &mut Context<'_>,
+        buffer: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.get_mut().inner).poll_read(context, buffer)
+    }
+}
+
+impl<IO: AsyncWrite + Unpin> AsyncWrite for DiagnosticIo<IO> {
+    fn poll_write(
+        self: Pin<&mut Self>,
+        context: &mut Context<'_>,
+        buffer: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        let this = self.get_mut();
+        this.observe("client_plaintext_write_attempt", buffer.len(), "enter");
+        let result = Pin::new(&mut this.inner).poll_write(context, buffer);
+        match &result {
+            Poll::Pending => this.observe("client_plaintext_write_result", 0, "pending"),
+            Poll::Ready(Ok(written)) => {
+                this.observe("client_plaintext_write_result", *written, "accepted")
+            }
+            Poll::Ready(Err(error)) => this.observe(
+                "client_plaintext_write_result",
+                0,
+                &format!("{:?}", error.kind()),
+            ),
+        }
+        result
+    }
+
+    fn is_write_vectored(&self) -> bool {
+        self.inner.is_write_vectored()
+    }
+
+    fn poll_write_vectored(
+        self: Pin<&mut Self>,
+        context: &mut Context<'_>,
+        buffers: &[io::IoSlice<'_>],
+    ) -> Poll<io::Result<usize>> {
+        let this = self.get_mut();
+        this.observe(
+            "client_plaintext_write_vectored_attempt",
+            buffers
+                .iter()
+                .fold(0usize, |total, buffer| total.saturating_add(buffer.len())),
+            "enter",
+        );
+        let result = Pin::new(&mut this.inner).poll_write_vectored(context, buffers);
+        match &result {
+            Poll::Pending => this.observe("client_plaintext_write_vectored_result", 0, "pending"),
+            Poll::Ready(Ok(written)) => this.observe(
+                "client_plaintext_write_vectored_result",
+                *written,
+                "accepted",
+            ),
+            Poll::Ready(Err(error)) => this.observe(
+                "client_plaintext_write_vectored_result",
+                0,
+                &format!("{:?}", error.kind()),
+            ),
+        }
+        result
+    }
+
+    fn poll_flush(self: Pin<&mut Self>, context: &mut Context<'_>) -> Poll<io::Result<()>> {
+        let this = self.get_mut();
+        this.observe("client_plaintext_flush_attempt", 0, "enter");
+        let result = Pin::new(&mut this.inner).poll_flush(context);
+        match &result {
+            Poll::Pending => this.observe("client_plaintext_flush_result", 0, "pending"),
+            Poll::Ready(Ok(())) => this.observe("client_plaintext_flush_result", 0, "complete"),
+            Poll::Ready(Err(error)) => this.observe(
+                "client_plaintext_flush_result",
+                0,
+                &format!("{:?}", error.kind()),
+            ),
+        }
+        result
+    }
+
+    fn poll_shutdown(self: Pin<&mut Self>, context: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.get_mut().inner).poll_shutdown(context)
+    }
+}
